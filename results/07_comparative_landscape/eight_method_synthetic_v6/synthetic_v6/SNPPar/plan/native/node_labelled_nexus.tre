#NEXUS
Begin taxa;
	Dimensions ntax=4;
	Taxlabels
		tipA
		tipB
		tipC
		tipD
		;
End;

Begin trees;
	Translate
		1 tipA,
		2 tipB,
		3 tipC,
		4 tipD
		;
tree TREE1 = [&R] ((1[&total=0,homoplasic=0,parallel=0]:0.1,2[&total=1,homoplasic=1,parallel=1]:0.1)N2[&total=0,homoplasic=0,parallel=0]:0.1,(3[&total=0,homoplasic=0,parallel=0]:0.1,4[&total=2,homoplasic=1,parallel=1]:0.1)N3[&total=1,homoplasic=0,parallel=0]:0.1)N1[&total=0,homoplasic=0,parallel=0];
End;
