  "parent_commit": "1150286b4c0ff43ef5533657d8c16456c68417db",
  "provider_identity_validation": {
    "not_found": {
      "identity_status": "not_applicable_not_found",
      "rule": "The exact request identity must still match the verified archived terminal record."
    },
    "openalex_doi_success": {
      "mismatch_status": "provider_identity_mismatch",
      "requested_normalization": "Trim whitespace, remove DOI URL or doi: prefix, and compare case-insensitively.",
      "required": true,
      "required_response_evidence": [
        "ids is an object",
        "ids.doi is present and non-empty",
        "normalized ids.doi equals normalized requested DOI",
        "top-level OpenAlex id is present and canonical"
      ]
    },
    "openalex_work_id_success": {
      "mismatch_status": "provider_identity_mismatch",
      "requested_normalization": "Normalize requested value to canonical OpenAlex Work token W<digits>.",
      "required": true,
      "required_response_evidence": [
        "top-level id is a canonical OpenAlex Work identifier",
        "top-level id Work token equals requested Work token",
        "ids is an object",
        "if ids.openalex is present, its Work token also equals requested Work token"
      ]
    },
    "pubmed_success": {
      "required": true,
      "rule": "Returned primary PMID must equal the exact requested PMID. The frozen transport and normalizer both enforce this condition."
    }
  },
  "purpose": "Provide a pure evidence-validation layer between the frozen exact-identifier transport and the Wave A authorization guard without modifying either frozen transport implementation.",
  "request_pacing": {
    "implementation": "retrieve_metadata_resolution_queue.ProviderPacer",
    "maximum_initiation_rate_per_provider_per_second": 2.0,
    "minimum_interval_seconds": 0.5,
    "reason": "Pacing at logical-lookup level alone does not cover redirect hops initiated internally by request_with_redirects.",
    "required_location": "executor_wrapper",
    "rule": "The injected executor must call ProviderPacer.wait(request.provider) immediately before every underlying HTTP executor invocation.",
    "unpaced_underlying_executor_permitted": false
  },
  "schema_version": 1,
  "status": "FROZEN_PRE_IMPLEMENTATION",
  "transport_outcome_policy": {
    "automatic_resume_after_fault_permitted": false,
    "automatic_retry_after_fault_permitted": false,
    "checkpoint_eligible": [
      "verified_success",
      "verified_not_found"
    ],
    "fault_action": "halt_execution_without_advancing_guard_checkpoint",
    "fault_recovery": "Requires a separately frozen recovery design before any further live request for the same manifest position.",
    "non_checkpointing_execution_faults": [
      "authentication_failure",
      "redirect_failure",
      "response_integrity_failure",
      "retry_exhausted",
      "provider_identity_mismatch",
      "missing_terminal_archive",
      "archive_verification_failure",
      "unknown_transport_status"
    ],
    "rationale": "Several frozen transport failure paths return a status without writing terminal.json. They must not be silently promoted to verified terminal evidence or allowed to advance Wave A."
  },
